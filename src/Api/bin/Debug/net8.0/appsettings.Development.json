{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DisableAuthentication": true,
  "ASPNETCORE_ENVIRONMENT": "Development",
  "ConnectionStrings": {
    "PostgreSQL": "Host=postgres;Port=5432;Database=realtime_chat;Username=devuser;Password=devpass;",
    "Redis": "redis:6379"
  },
  "JwtAuthority": "https://your-auth-server.example.com",
  "JwtAudience": "chat-api",
  "RateLimit": {
    "PerSecond": 100,
    "PerMinute": 1000
  }
}
