{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Error"
    }
  },
  "AllowedHosts": "*",
  "DisableAuthentication": false,
  "ASPNETCORE_ENVIRONMENT": "Production",
  "ConnectionStrings": {
    "PostgreSQL": "Host=${DB_HOST};Port=${DB_PORT};Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD};",
    "Redis": "${REDIS_URL:-redis:6379}"
  },
  "JwtAuthority": "${JWT_AUTHORITY}",
  "JwtAudience": "${JWT_AUDIENCE:-chat-api}",
  "RateLimit": {
    "PerSecond": 100,
    "PerMinute": 1000
  }
}
